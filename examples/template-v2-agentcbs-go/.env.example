# Supply your own credentials. Existing exported variables take precedence.
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=
TENCENTCLOUD_TOKEN=
# Region used by both the control plane and data volume.
TENCENTCLOUD_REGION=ap-nanjing

# Required for demo. Use a custom tool with a READY v2 template.
AGS_TOOL_ID=
# Optional: leave empty to create a new 20Gi volume; set it to reuse a volume.
AGS_VOLUME_ID=

# Required only for make create-tool. Use your own image-pull role.
AGS_ROLE_ARN=
# Optional overrides used only when creating a new tool.
AGS_TOOL_NAME=
AGS_IMAGE=ccr.ccs.tencentyun.com/ags-image/sandbox-code:latest
